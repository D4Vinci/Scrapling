{% set translations = {
  "<p>This class is returned by all engines as a way to unify the response type between different libraries.</p>": "<p>تعيد كل المحركات هذه الفئة لتوحيد نوع الرد بين المكتبات المختلفة.</p>",
  "<p>HTTP status code.</p>": "<p>رمز حالة HTTP.</p>",
